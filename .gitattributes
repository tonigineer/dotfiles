# Noctalia rewrites these at runtime and keeps the Wallhaven api_key in them.
# The filter commits `api_key = ""` while the worktree keeps the live key. A
# filter is git config, not repo content, so it does nothing until
# 031-shells.sh configures it on this clone.
.local/state/noctalia/settings.*.toml filter=noctalia-key
