.luarc.json

.config/btop/themes/noctalia.theme

.config/kitty/themes
.config/kitty/kitty.conf.bak
.config/kitty/current-theme.conf

# Generated by Noctalia's spicetify template whenever the palette changes.
# Comfy is the theme 054-spotify.sh applies; Colorful/ holds nothing else.
.config/spicetify/Themes/Comfy/color.ini
.config/spicetify/Themes/Colorful/color.ini

# Written by skwd-wall (058-wallpaper.sh), which Noctalia then consumes as
# theme.source = "custom", custom_palette = "skwd-wall".
.config/noctalia/palettes/

.config/yazi/plugins
.config/yazi/package.toml
.config/yazi/theme.toml
.config/yazi/flavors/noctalia.yazi

.config/zed/themes

# Linked per host into $HOME by 031-shells.sh (host_links), pointing at
# settings.<hostname>.toml. Never track it here.
.local/state/noctalia/settings.toml
