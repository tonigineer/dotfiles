#!/usr/bin/env bash
#
# ~/.local/bin/claude-ollama — Claude Code against a local Ollama model.
#
# `ollama launch claude` does most of the wiring: it points ANTHROPIC_BASE_URL
# at 127.0.0.1:11434, sets ANTHROPIC_AUTH_TOKEN, and maps every model tier
# (opus/sonnet/haiku plus CLAUDE_CODE_SUBAGENT_MODEL) onto the one local model.
# This script no longer delegates to it, for two reasons.
#
# The first is the context window. Claude Code only knows the context length of
# models it ships a table for, so a local name like "qwen3.8" falls back to an
# assumed 200k and it never auto-compacts in time. Because llama-server runs
# with --context-shift the overflow is silent: the oldest tokens (the system
# prompt and the tool definitions) are dropped and the model carries on without
# them. Setting CLAUDE_CODE_MAX_CONTEXT_TOKENS is what makes Claude Code
# compact before that happens, and it is set a margin below the real number --
# see the Context section for why the two sides cannot be given the same value.
# The window is read from the running unit rather than hardcoded, so this stays
# correct if the drop-in is edited and cannot silently disagree with it.
#
# The second is thinking, and it is why the delegation had to go. Ollama reads a
# request with no `thinking` field as thinking enabled, Claude Code always omits
# that field, and the resulting reasoning tokens count against max_tokens — so
# turns die with "response exceeded the N output token maximum". The fix is a
# shim that inserts {"type": "disabled"} per request; see claude-ollama-proxy.py
# for why it cannot live in the model or the server. That means Claude Code has
# to point at the shim's port instead of Ollama's, and `ollama launch` overwrites
# ANTHROPIC_BASE_URL with its own value even when one is already exported. So the
# environment is set here directly, which is the same wiring, one port over.
#
# Usage:
#   claude-ollama                      # default model, interactive
#   claude-ollama qwen3.6              # pick a model
#   claude-ollama qwen3.8 -p 'hi'      # trailing args go to claude

set -euo pipefail

default_model=qwen3.8

# Ollama's own fallback when OLLAMA_CONTEXT_LENGTH is unset on a card this
# size. Assuming the larger configured value instead would reintroduce exactly
# the silent-truncation bug this script exists to prevent.
fallback_ctx=32768

# Claude Code's fixed overhead — system prompt plus tool schemas — measured
# from the server log (`task.n_tokens`) on a no-op prompt. Only used to warn.
overhead=25000

# Kept well under the window: this is a per-turn output ceiling, not a budget
# to spend, and Claude Code aborts the turn if a response reaches it.
max_output=8192

ollama_port=11434
proxy_port="${CC_PROXY_PORT:-11435}"
proxy_unit=claude-ollama-proxy.service

# ── Model ───────────────────────────────────────────────────────────────

model=$default_model
if [ $# -gt 0 ] && [ "$1" != "--" ] && [ "${1#-}" = "$1" ]; then
    model=$1
    shift
fi
[ "${1:-}" = "--" ] && shift || true

# ── Backend ─────────────────────────────────────────────────────────────

if ! curl -sf -m 3 -o /dev/null "http://127.0.0.1:${ollama_port}/api/tags"; then
    echo "claude-ollama: nothing answering on 127.0.0.1:${ollama_port} —" \
        "start it with 'sudo systemctl start ollama'." >&2
    exit 1
fi

# The shim runs as a user unit so it outlives the terminal that first needed
# it and two shells starting at once cannot race to bind the port.
if ! curl -s -m 2 -o /dev/null "http://127.0.0.1:${proxy_port}/api/tags"; then
    systemctl --user start "$proxy_unit" 2>/dev/null || true
    for _ in $(seq 1 40); do
        curl -s -m 1 -o /dev/null "http://127.0.0.1:${proxy_port}/api/tags" &&
            break
        sleep 0.25
    done
    if ! curl -s -m 2 -o /dev/null "http://127.0.0.1:${proxy_port}/api/tags"; then
        echo "claude-ollama: the ${proxy_unit} shim is not answering on" \
            "${proxy_port}. Check 'systemctl --user status ${proxy_unit}'." >&2
        exit 1
    fi
fi

# ── Context ─────────────────────────────────────────────────────────────

# systemctl show resolves the drop-in against the base unit, so this reports
# what the service is really running with, override present or not.
ctx=$(systemctl show ollama --property=Environment --value 2>/dev/null |
    tr ' ' '\n' | sed -n 's/^OLLAMA_CONTEXT_LENGTH=//p' | tail -1)

if [ -z "$ctx" ]; then
    ctx=$fallback_ctx
    echo "claude-ollama: ollama.service sets no OLLAMA_CONTEXT_LENGTH;" \
        "assuming $ctx. Install the 056-ollama module to raise it." >&2
fi

# Claude Code and Ollama do not count the same tokens. Claude Code budgets
# against the API's usage numbers; Ollama counts the prompt it renders, which
# also carries the Qwen chat template and the tool schemas in Qwen's own
# format. Handing Claude Code the raw window therefore leaves no room for the
# disagreement, and Ollama is the side that reaches the limit first -- it
# drops the oldest messages, which in an agentic loop is the turn holding the
# actual request. Reserving a margin makes Claude Code compact while the task
# description is still in the window.
cc_ctx=$((ctx * 85 / 100))

if [ "$ctx" -le "$((overhead + 8000))" ]; then
    echo "claude-ollama: context is $ctx and Claude Code spends ~$overhead" \
        "on its system prompt and tools — only $((ctx - overhead)) tokens are" \
        "left for actual work. Expect frequent compaction." >&2
fi

# ── Launch ──────────────────────────────────────────────────────────────

export ANTHROPIC_BASE_URL="http://127.0.0.1:${proxy_port}"
export ANTHROPIC_AUTH_TOKEN=ollama
export ANTHROPIC_MODEL="$model"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$model"
export ANTHROPIC_SMALL_FAST_MODEL="$model"
export CLAUDE_CODE_SUBAGENT_MODEL="$model"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$cc_ctx"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$max_output"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

exec claude "$@"
