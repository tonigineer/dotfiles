#!/usr/bin/env bash
#
# ~/.local/bin/claude-strata — Claude Code against the local Strata server.
#
# Strata serves an Anthropic-compatible API on 127.0.0.1:8080, so unlike the
# Ollama path this needs no shim in front of it: `strata connect claude-code`
# prints the exact environment Claude Code wants and it is reproduced below.
# What that command also prints is an instruction to merge the same environment
# into ~/.claude/settings.json, and avoiding that is most of why this script
# exists. settings.json is global and unconditional: ANTHROPIC_BASE_URL in it
# points *every* Claude Code session at this box, including the ones meant to
# reach Anthropic, and the only way back is to edit the file again. The
# environment therefore lives in a wrapper, one invocation at a time, exactly
# as claude-ollama does it.
#
# Two workarounds that claude-ollama carries are deliberately absent:
#
#   1. No thinking proxy. Ollama treats a /v1/messages request with no
#      `thinking` field as thinking ENABLED, and the reasoning tokens then
#      count against max_tokens, which is what claude-ollama-proxy.py is for.
#      Strata fixes that server-side: with thinking on, no explicit budget and
#      max_tokens of 1024 or more it reserves a quarter of the cap (at least
#      512 tokens) for the answer and wraps the thinking up when it gets there
#      ("answer_room", engine 0.1.45). Nothing has to be rewritten per
#      request, so Claude Code talks to the server directly.
#
#   2. No context margin. The 15% claude-ollama holds back exists because
#      llama-server runs with --context-shift, where an overflow is not an
#      error but a silent eviction of the oldest tokens — the system prompt and
#      the tool schemas. Strata refuses the request instead ("prompt ... exceeds
#      the context"), so an overflow is loud rather than a model that quietly
#      forgot its tools, and Claude Code can be given the real window.
#      Upstream's tested configuration passes the served context unmodified.
#
# The window is still read from the running server instead of being hardcoded,
# for the same reason as in claude-ollama: --context is a launch-time flag and
# a preset can be re-saved with a different one, so the number has exactly one
# source of truth and the two sides cannot silently disagree.
#
# The server outlives the session unless something stops it: `strata launch`
# detaches a runtime of its own, so quitting Claude Code leaves 50-60 GB of
# weights pinned and the card fully allocated for nothing. This script
# therefore stops the server when the last session using it exits -- also one
# it merely found running, since a server outliving its session is how one ends
# up pinned for hours. Sessions are counted, so closing one of two leaves the
# other its model; a session killed without a chance to clean up is released
# by a detached reaper. Stopping waits for the engine to really exit (and kills
# it if it will not), then drops the model files from the page cache.
# CC_STRATA_KEEP=1 keeps it loaded, which is the right call when another
# session is coming: a reload stalls the desktop for one to three minutes.
#
# Starting is made to succeed: each try begins with a clean card (leftover
# engines killed, Ollama's models unloaded) and an empty page cache, and a
# start that fails is retried without the draft layer, then at half the
# context, for that start only.
#
# Usage:
#   claude-strata                           # interactive
#   claude-strata -p 'summarise this repo'  # args are passed to claude
#   CC_STRATA_THINKING=1024 claude-strata   # shallower thinking, see below
#   CC_STRATA_NO_START=1 claude-strata      # fail instead of loading the model
#   CC_STRATA_KEEP=1 claude-strata          # leave the server loaded on exit
#   CC_STRATA_PERMISSION_MODE=manual claude-strata   # prompt for every tool call

set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
port="${CC_STRATA_PORT:-8080}"
base="http://127.0.0.1:${port}"
preset="${CC_STRATA_PRESET:-default}"

# Any value works: with --access local Strata listens on the loopback only and
# checks no key. Claude Code still refuses to start without a token set.
auth_token="${CC_STRATA_KEY:-strata-local}"

# Per-turn output ceiling, and with thinking left to the server it is also the
# room the reasoning has to work in: Strata reserves a quarter of this (at least
# 512 tokens) for the answer and wraps the thinking up when it reaches that
# line. 16384 therefore buys about 12k tokens of reasoning and 4k of answer.
# Upstream's tested value is 4096, which is a latency choice; this box is set up
# for the best answer rather than the quickest one, and the context is 128k, so
# the allowance is cheap. Qwen's own guidance is that a client should not cap the
# reply far below what the context allows.
max_output="${CC_STRATA_MAX_OUTPUT:-16384}"

# Thinking budget in tokens, which on the Anthropic endpoint selects the level
# as well as capping it: under 2K is low, under 8K medium, above that high.
#
# Left at 0, which is not "no thinking": Claude Code suppresses the field
# entirely at 0 rather than sending {"type": "disabled"}, and Strata's own
# default for a request that names no level is **high**. So 0 asks for the most
# reasoning the model will do, bounded only by the answer-room rule above.
#
# This script used to pin 4096 (medium) to keep mechanical tool-calling turns
# snappy. That is the wrong trade here: the point of running a 125B model on a
# box too small for it is the quality of the answer, and reasoning depth is the
# cheapest lever on that. Set CC_STRATA_THINKING=1024 for a fast, shallow turn.
think="${CC_STRATA_THINKING:-0}"

# The flags that produced the saved preset. Kept here because the preset lives
# in Strata's generated settings.json, which is not tracked: this is the
# recipe, the preset is the cache.
launch_flags=(
    --model iq3_s --data-dir /data/strata
    # 128k. 256k (the model's full 262144 window) ran for two days, but its KV cache left the
    # draft head no VRAM to spare: on 2026-10-24 the start failed with "the draft head over
    # 106299 tokens needs 213 MiB of VRAM and 213 MiB is free". 128k is what the tune passed at.
    --context 128k --vision gpu --tune skip
    --access local --port "$port"
    # --parallel 1 against the server's own choice of 3. Each request slot reserves VRAM that the
    # expert cache would otherwise hold -- 5.66 GiB of it here, more than half the cache -- and on
    # a box this short of RAM the cache is what keeps experts off the SSD. Measured with
    # `strata bench run` at 4K: decode 34.6 -> 67.8 tok/s, prompt 277 -> 432 tok/s, first token
    # 14.8 -> 9.5 s, sanity checks 12/12 either way. `strata tune auto --use coding` then found
    # nothing further worth changing. Three slots only pay for concurrent users, and there is one.
    --parallel 1
)

health() { curl -sf -m 5 "$base/health" 2>/dev/null; }
loaded() { [ "$(health | jq -r '.loaded // false')" = true ]; }
say() { echo "claude-strata: $*" >&2; }

# The engine and its picture reader both run from the engine component's folder, whatever started
# them: this script, the Strata app, or a launch whose runtime has since died.
engine_pat='/strata/components/engine/'
engine_pids() { pgrep -f -- "$engine_pat" | paste -sd' ' -; }

# Every session leaves a file named by its PID here, so the last one out can tell it is the last.
# The runtime directory is a tmpfs that a logout clears, so no stale state outlives the login.
state="${XDG_RUNTIME_DIR:-/tmp/claude-strata-$UID}/claude-strata"
sessions="$state/sessions"
mkdir -p "$sessions"
log="$HOME/.local/state/strata/launch/$preset.engine.log"

# A PID is only a session while it is still this script: after a crash the number can come back as
# something else entirely, and a stale file must not keep the model loaded forever.
is_session() { tr '\0' '\n' 2>/dev/null <"/proc/$1/cmdline" | sed -n 2p | grep -q '/claude-strata$'; }

# Live sessions other than $1; files of dead ones are removed on the way.
other_sessions() {
    local f pid n=0
    for f in "$sessions"/*; do
        [ -e "$f" ] || continue
        pid=${f##*/}
        [ "$pid" = "$1" ] && continue
        if is_session "$pid"; then n=$((n + 1)); else rm -f "$f"; fi
    done
    echo "$n"
}

# The page cache still holds earlier runs' model files, and the engine sizes its page-locked
# expert copy from what is free at start: with ~28 GiB of it cached the whole copy did not fit
# ("the whole resident RAM mode does not fit") and part of it was read from the SSD instead.
# Linux would give the pages back on demand, but the engine measures before it asks. sudo -n
# never prompts, so where it needs a password this is skipped rather than hanging.
drop_caches() { sync && echo 1 | sudo -n tee /proc/sys/vm/drop_caches >/dev/null 2>&1; }

# Stops whatever Strata has running and makes sure it is really gone. `strata launch --stop` only
# reaches what its own runtime still knows about; an engine whose launch died (or that a failed
# start left behind) keeps the card and the pinned RAM until it is killed.
free_card() {
    local sig
    timeout 120 strata launch --stop >/dev/null 2>&1 || true
    for sig in TERM KILL; do
        for _ in $(seq 1 15); do
            [ -z "$(engine_pids)" ] && return 0
            sleep 1
        done
        say "the engine did not exit; sending SIG$sig to $(engine_pids)."
        pkill -"$sig" -f -- "$engine_pat" || true
    done
    sleep 2
    [ -z "$(engine_pids)" ] || say "engine processes survived SIGKILL: $(engine_pids)."
}

# Ollama wants the same card. Its models reload on their next request, so unloading costs nothing
# but that request's start, while leaving one resident can push the engine over the edge.
unload_ollama() {
    local m
    command -v ollama >/dev/null 2>&1 || return 0
    for m in $(timeout 10 ollama ps 2>/dev/null | awk 'NR > 1 && NF {print $1}'); do
        say "unloading $m from ollama to free the card."
        timeout 30 ollama stop "$m" >/dev/null 2>&1 || true
    done
}

# Unregisters session $1 and, when no other session is left, stops Strata, frees the card and drops
# the model files from the page cache. Run by the session's own exit trap, or by its reaper when the
# session died without running one.
release() {
    local n
    exec 9>"$state/lock"
    flock 9
    rm -f "$sessions/$1"
    n=$(other_sessions "$1")
    if [ -n "${CC_STRATA_KEEP:-}" ]; then
        say "CC_STRATA_KEEP is set, so Strata stays loaded; 'strata launch --stop' frees it."
    elif [ "$n" -gt 0 ]; then
        say "$n other session(s) still use Strata, so it stays loaded."
    else
        if [ -n "$(engine_pids)" ] || health >/dev/null; then
            say "stopping Strata — freeing the weights and the card."
        fi
        free_card
        drop_caches || true
    fi
    flock -u 9
}

# `strata launch` returns once the server answers, but /health answers before the weights finish
# loading, and a request sent in that gap fails rather than queueing. An engine that dies while
# loading stops answering altogether, which ends the wait early instead of after five minutes.
wait_loaded() {
    local snap missed=0
    for _ in $(seq 1 300); do
        if snap=$(health); then
            missed=0
            [ "$(jq -r '.loaded // false' <<<"$snap")" = true ] && return 0
        else
            missed=$((missed + 1))
            [ "$missed" -ge 20 ] && return 1
        fi
        sleep 1
    done
    return 1
}

# Each try starts from a clean card and an empty page cache, and each one after the first gives up
# something to fit: the draft layer first (about 1 GB of VRAM, slower answers), then half the
# context. A start that fails for want of memory, like the draft head that came up 1 MiB short on
# 2026-10-24, therefore still ends with a working server instead of an error.
fallbacks=("" "--mtp off" "--mtp off --context 64k")

start_backend() {
    local args extra save=()
    # The listing is a table — name, size, context, batching, tuning, date — so the name is the
    # first column rather than the whole line.
    if strata launch --list-presets 2>/dev/null | awk '{print $1}' | grep -qxF "$preset"; then
        args=(--preset "$preset")
    else
        say "no saved preset '$preset'; using the recipe in this script."
        args=("${launch_flags[@]}")
        save=(--save-preset "$preset")
    fi

    for extra in "${fallbacks[@]}"; do
        free_card
        unload_ollama
        drop_caches || say "could not drop the page cache (sudo wants a password); loading anyway."
        [ -z "$extra" ] || say "retrying with $extra for this start (the preset is unchanged)."
        # shellcheck disable=SC2086  # $extra is a list of flags
        if strata launch "${args[@]}" "${save[@]}" $extra --no-tui --yes >&2 && wait_loaded; then
            return 0
        fi
        save=()
        say "the start failed. The engine log ($log) ends with:"
        tail -n 4 "$log" 2>/dev/null | sed 's/^/    /' >&2 || true
    done
    return 1
}

# ── Reaper ──────────────────────────────────────────────────────────────

# A session that is killed outright (SIGKILL, an OOM kill, a crashed terminal) runs no trap, and the
# model would stay loaded with nobody to unload it. Every session therefore starts a detached copy
# of this script that waits for it to end and releases it if it did not release itself.
if [ -n "${CC_STRATA_REAP:-}" ]; then
    tail --pid="$CC_STRATA_REAP" -f /dev/null
    if [ -e "$sessions/$CC_STRATA_REAP" ]; then
        echo "$(date '+%F %T') session $CC_STRATA_REAP ended without releasing Strata" >&2
        release "$CC_STRATA_REAP"
    fi
    exit 0
fi

# ── Backend ─────────────────────────────────────────────────────────────

: >"$sessions/$$"
CC_STRATA_REAP=$$ setsid -f "$self" </dev/null >>"$state/reaper.log" 2>&1

released=0
# shellcheck disable=SC2329  # invoked by the traps below
cleanup() {
    [ "$released" = 0 ] || return 0
    released=1
    release $$
}
trap cleanup EXIT
trap 'cleanup; exit 129' HUP
trap 'cleanup; exit 143' TERM
trap 'cleanup; exit 130' INT

# Starting holds the lock, so two sessions opened together load the model once: the second waits
# and then finds it loaded.
exec 9>"$state/lock"
flock 9
if ! loaded; then
    if [ -n "${CC_STRATA_NO_START:-}" ]; then
        say "no loaded model on $base and CC_STRATA_NO_START is set. Start it with" \
            "'strata launch --preset $preset'."
        exit 1
    fi
    command -v strata >/dev/null 2>&1 || {
        say "strata is not installed. Install the Terminal with" \
            "'curl -fsSL https://github.com/Niko1221/Strata/releases/latest/download/install.sh | sh'."
        exit 1
    }

    # Something that answers but never finishes loading (a start from elsewhere) gets its chance
    # before it is replaced.
    if health >/dev/null && wait_loaded; then
        :
    else
        # Loading pins 50-60 GB of weights and hands part of it to the card. The desktop can stall
        # for one to three minutes while that happens, so say so before it starts rather than
        # letting it look like a hang.
        say "starting Strata — it loads ~84 GB of model and the desktop may stall for 1-3 minutes."
        if [ -n "${CC_STRATA_KEEP:-}" ]; then
            say "CC_STRATA_KEEP is set, so it stays loaded after this session;" \
                "'strata launch --stop' frees it."
        else
            say "it is stopped again when the last session exits;" \
                "CC_STRATA_KEEP=1 leaves it loaded for the next one."
        fi
        start_backend || {
            say "Strata did not start with any of the fallbacks. Check $log."
            exit 1
        }
    fi
fi
flock -u 9

snapshot=$(health || true)
[ -n "$snapshot" ] || {
    say "$base stopped answering. Check 'strata launch --status' and $log."
    exit 1
}

# ── Context ─────────────────────────────────────────────────────────────

ctx=$(jq -r '.max_context // empty' <<<"$snapshot")
model=$(jq -r '.model // "strata"' <<<"$snapshot")

if [ -z "$ctx" ]; then
    # Every tier this box can run is launched at 128k, but guessing high is the
    # one failure mode worth avoiding: it is what stops Claude Code compacting
    # before the server starts refusing turns.
    ctx=32768
    echo "claude-strata: $base/health reports no max_context; assuming $ctx." >&2
fi

# Claude Code spends ~25k tokens on its system prompt and tool schemas before
# the first user turn, so a small window leaves little for the task itself.
overhead=25000
if [ "$ctx" -le "$((overhead + 8000))" ]; then
    echo "claude-strata: the served context is $ctx and Claude Code spends" \
        "~$overhead on its system prompt and tools — only $((ctx - overhead))" \
        "tokens are left for work. Relaunch with a larger --context." >&2
fi

if [ "$think" -gt 0 ] && [ "$think" -ge "$((max_output - 1024))" ]; then
    echo "claude-strata: a thinking budget of $think leaves under 1024 tokens" \
        "of the $max_output output cap for the answer. Raise" \
        "CC_STRATA_MAX_OUTPUT or lower CC_STRATA_THINKING." >&2
fi

# ── Permissions ─────────────────────────────────────────────────────────

# Auto mode cannot work against this server, and it fails closed when it
# cannot work. Every action it allows is first cleared by a safety classifier,
# and that classifier is an API request like any other, so it follows
# ANTHROPIC_BASE_URL to Strata — which serves a chat model and nothing that
# answers a safeguard check. Claude Code gets no verdict, blocks for safety,
# and every command comes back "denied by auto mode · Classifier unavailable"
# while /status reports the auto mode server as disabled. There is no local
# answer either: a 125B model adjudicating every tool call would cost more
# than the turn it guards. So the session starts in a mode that needs no
# verdict. acceptEdits keeps file edits silent and still prompts for commands
# outside the allow list in ~/.claude/settings.json;
# CC_STRATA_PERMISSION_MODE=manual prompts for both, an empty value injects
# nothing and leaves Claude Code its own default, and an explicit
# --permission-mode or skip-permissions flag on the command line wins.
permission_mode="${CC_STRATA_PERMISSION_MODE-acceptEdits}"

for arg in "$@"; do
    case "$arg" in
        --permission-mode | --permission-mode=* | \
            --dangerously-skip-permissions | --allow-dangerously-skip-permissions)
            permission_mode="" ;;
    esac
done

mode_args=()
if [ -n "$permission_mode" ]; then
    mode_args=(--permission-mode "$permission_mode")
fi

# Starting outside auto mode is not enough: Shift+Tab still cycles into it, and
# then every command stalls on a classifier request Strata times out on ("is
# temporarily unavailable (timed out), so auto mode cannot determine the
# safety of Bash"). disableAutoMode takes it out of the cycle, and passed via
# --settings it applies to this session only, not to ~/.claude/settings.json.
mode_args+=(--settings '{"permissions":{"disableAutoMode":"disable"}}')

# ── Launch ──────────────────────────────────────────────────────────────

export ANTHROPIC_BASE_URL="$base"
export ANTHROPIC_AUTH_TOKEN="$auth_token"
export ANTHROPIC_MODEL="$model"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$model"
export ANTHROPIC_SMALL_FAST_MODEL="$model"
export CLAUDE_CODE_SUBAGENT_MODEL="$model"
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$ctx"
export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$max_output"
export MAX_THINKING_TOKENS="$think"

# One local server, no Anthropic account in the loop: the status line, the
# update check and the telemetry have nothing to reach and only add latency.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_AUTOUPDATER=1
export DISABLE_TELEMETRY=1

# Not exec'd: exec replaces this shell, and the trap with it, so the server
# would stay loaded. Claude Code's exit status is passed on unchanged, and the
# `|| status=$?` keeps a non-zero one from skipping the exit line under set -e.
# Ctrl-C belongs to Claude Code from here on (it cancels a turn): with the INT
# trap still set, bash would hold the signal and run the trap once Claude Code
# exits, turning its exit status into 130. The EXIT trap and the reaper still
# release the session.
trap - INT
status=0
claude "${mode_args[@]}" "$@" || status=$?
exit "$status"
