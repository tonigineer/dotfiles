#!/usr/bin/env bash
#
# kraken-lcd — switch the NZXT Kraken Elite LCD animation.
#
# Called from the Hyprland gamemode listener (conf/autostart.lua) and usable by
# hand. Idempotent: re-running with the current mode is a no-op, because the
# Hyprland listener fires on every config reload (twice per editor save) and a
# GIF push costs ~5s and several MB over USB.
#
# `--forget` drops the remembered mode, so the next call pushes even if the
# mode is unchanged. resume-restore uses it after hibernation: the cooler
# loses its image across the power cycle, but the boot id comes back from the
# hibernation image, so the boot-scoped state below would otherwise still
# claim the current mode and the LCD would stay blank.
#
set -euo pipefail

anim_dir="$HOME/Pictures/Animations"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
state="$state_dir/kraken-lcd.state"
lock="$state_dir/kraken-lcd.lock"
log="$state_dir/kraken-lcd.log"

force=0
[ "${1:-}" = "--force" ] && { force=1; shift; }

if [ "${1:-}" = "--forget" ]; then
    mkdir -p "$state_dir"
    exec 9>"$lock"
    flock 9
    rm -f "$state"
    exit 0
fi

case "${1:-}" in
    doom)  gif="$anim_dir/doom-e1m1-640.gif" ;;
    pixel) gif="$anim_dir/pixel.gif" ;;
    *)     echo "usage: ${0##*/} [--force] {doom|pixel} | --forget" >&2; exit 2 ;;
esac

mkdir -p "$state_dir"

# The cooler loses its image across a power cycle, so the remembered mode is only
# valid within one boot: pair it with the kernel's boot id and the first call
# after a reboot always pushes, however the previous session left the state file.
boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
want="$1 $boot_id"

# Serialize: the Hyprland listener can fire twice in quick succession, and two
# concurrent bulk writes to the LCD make each other fail (visible in the log as
# "attempt 2"). The loser of the lock waits, then sees the state below and exits.
exec 9>"$lock"
flock 9

# Skip silently when already in the requested mode on this boot.
if [ "$force" -eq 0 ] && [ "$(cat "$state" 2>/dev/null || true)" = "$want" ]; then
    exit 0
fi

# The cooler can be busy or still re-enumerating; retry before giving up.
for i in 1 2 3 4 5; do
    if liquidctl --match kraken set lcd screen gif "$gif" 2>/dev/null; then
        printf '%s  %-5s -> %s (attempt %d)\n' "$(date -Is)" "$1" "${gif##*/}" "$i" >> "$log"
        printf '%s' "$want" > "$state"
        exit 0
    fi
    sleep 2
done

printf '%s  %-5s -> FAILED\n' "$(date -Is)" "$1" >> "$log"
exit 1
