#!/usr/bin/env bash
#
# zed-glass — make the Noctalia Zed theme see-through, or solid again.
#
# Usage: zed-glass {on|off|sync}
#
# Noctalia renders .config/noctalia/templates/zed.json into
# ~/.config/zed/themes/noctalia.json, always solid. `on` sets that render aside
# and writes a glass copy over it: the window background at 70% (the bar's),
# editor, panels and bars clear so that one glass layer shows through, popups
# nearly solid. Hyprland blurs what is behind it in the elegant profile. `off`
# puts the solid render back. Zed reloads theme files live, so settings.json
# (tracked) never changes.
#
# `sync` applies what the saved desktop profile wants. desktop-profile calls it
# on every switch, and the Zed template's post_hook calls it after every
# Noctalia re-render, which writes a solid theme again. Both can run at once
# during a switch (the palette change re-renders), hence the lock.
#
set -euo pipefail

theme="${XDG_CONFIG_HOME:-$HOME/.config}/zed/themes/noctalia.json"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-profile"
solid="$state_dir/zed-noctalia.solid.json"

mode=${1:-}
if [ "$mode" = sync ]; then
    [ "$(cat "$state_dir/name" 2>/dev/null)" = elegant ] && mode=on || mode=off
fi
case "$mode" in
    on|off) ;;
    *) echo "usage: ${0##*/} {on|off|sync}" >&2; exit 2 ;;
esac

# No Noctalia render on this machine (yet): nothing to do.
[ -f "$theme" ] || exit 0
mkdir -p "$state_dir"
exec 9>"$state_dir/zed-glass.lock"
flock 9

# Outside the themes dir: Zed loads every file there.
tmp=$(mktemp "$state_dir/zed-noctalia.XXXXXX")
trap 'rm -f "$tmp"' EXIT

glass=$(jq -r '.themes[0].style."background.appearance" == "blurred"' "$theme")

if [ "$mode" = off ]; then
    # A solid theme is already right: either never glassed or freshly rendered.
    if [ "$glass" = true ] && [ -f "$solid" ]; then
        cp "$solid" "$tmp"
        mv "$tmp" "$theme"
    fi
    exit 0
fi

# on: glass is always derived from a solid render, never from itself.
[ "$glass" = true ] && exit 0
cp "$theme" "$solid"

# Alpha is appended to plain #RRGGBB values only, so colours the template
# already gives an alpha keep theirs.
jq '
    def alpha($a): if type == "string" and test("^#[0-9A-Fa-f]{6}$") then . + $a else . end;
    def set_alpha($keys; $a): reduce $keys[] as $k (.; if has($k) then .[$k] |= alpha($a) else . end);

    .themes |= map(.style |= (
          ."background.appearance" = "blurred"
        # The one tinted glass layer everything else sits on.
        | set_alpha(["background"]; "b3")
        # Clear, so the layer above shows through instead of stacking tints.
        | set_alpha([
              "surface.background",
              "editor.background", "editor.gutter.background",
              "panel.background", "terminal.background",
              "toolbar.background", "tab_bar.background", "tab.inactive_background",
              "title_bar.background", "title_bar.inactive_background",
              "status_bar.background", "scrollbar.track.background"
          ]; "00")
        # Faint tint, enough to tell the active tab and sticky headers apart.
        | set_alpha(["tab.active_background", "editor.subheader.background"]; "66")
        # Popups, menus and completions stay readable over busy code.
        | set_alpha(["elevated_surface.background", "panel.overlay_background"]; "e6")
    ))
' "$solid" >"$tmp"
mv "$tmp" "$theme"
