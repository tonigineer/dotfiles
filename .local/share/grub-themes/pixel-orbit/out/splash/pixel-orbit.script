# Pixel Orbit boot splash
# Generated by Dotfiles/.local/share/grub-themes/pixel-orbit/build.py; edit that, not this.
# Opens on the frame GRUB already shows (launch.png), sets the satellite moving,
# then types the launch log in line by line and brings up the progress bar.
# One image set per display size (set[]); layout() uses the largest that fits
# and centres it on every display.
#
# z: sky 0, glints 5, satellite 10 (far side) / 40 (near side), earth 20,
# near orbit 30, log and bar 50.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
mode = Plymouth.GetMode();

set[0].dir = "1440/";
set[0].w = 2560;
set[0].h = 1440;
set[0].k = 1;
set[0].earth_x = 1410;
set[0].earth_y = 150;
set[0].orbit_x = 1297;
set[0].orbit_y = 697;
set[0].cx = 1900;
set[0].cy = 700;
set[0].rx = 600;
set[0].ry = 150;
set[0].sat_w = 45;
set[0].sat_h = 25;
set[0].glint_half = 7;
set[0].log_x = 204;
set[0].type_px = 34;
set[0].bar_x = 204;
set[0].bar_y = 675;
set[0].fill_x = 212;
set[0].fill_y = 683;
set[0].fill_h = 12;
set[0].inner = 904;
set[1].dir = "2160/";
set[1].w = 3840;
set[1].h = 2160;
set[1].k = 1.5;
set[1].earth_x = 2115;
set[1].earth_y = 225;
set[1].orbit_x = 1945;
set[1].orbit_y = 1045;
set[1].cx = 2850;
set[1].cy = 1050;
set[1].rx = 900;
set[1].ry = 225;
set[1].sat_w = 72;
set[1].sat_h = 40;
set[1].glint_half = 11;
set[1].log_x = 306;
set[1].type_px = 51;
set[1].bar_x = 306;
set[1].bar_y = 1012;
set[1].fill_x = 318;
set[1].fill_y = 1024;
set[1].fill_h = 18;
set[1].inner = 1356;

sky.sprite = Sprite();
earth.sprite = Sprite();
orbit.sprite = Sprite();
sat.sprite = Sprite();

# Glints: positions in the 2560x1440 layout, scaled by the set's k.
glint[0].x = 1086; glint[0].y = 774; glint[0].phase = 4.996; glint[0].speed = 0.0871;
glint[1].x = 2211; glint[1].y = 99; glint[1].phase = 5.280; glint[1].speed = 0.0788;
glint[2].x = 1060; glint[2].y = 1369; glint[2].phase = 0.326; glint[2].speed = 0.0478;
glint[3].x = 1049; glint[3].y = 819; glint[3].phase = 3.417; glint[3].speed = 0.0687;
glint[4].x = 93; glint[4].y = 483; glint[4].phase = 2.564; glint[4].speed = 0.0491;
glint[5].x = 334; glint[5].y = 324; glint[5].phase = 3.883; glint[5].speed = 0.0622;
glint[6].x = 581; glint[6].y = 43; glint[6].phase = 6.109; glint[6].speed = 0.0403;
glint[7].x = 1324; glint[7].y = 447; glint[7].phase = 3.388; glint[7].speed = 0.0739;
glint[8].x = 846; glint[8].y = 824; glint[8].phase = 1.877; glint[8].speed = 0.0581;
glint[9].x = 719; glint[9].y = 338; glint[9].phase = 1.658; glint[9].speed = 0.0566;
glint[10].x = 2510; glint[10].y = 1240; glint[10].phase = 0.021; glint[10].speed = 0.0739;
glint[11].x = 1424; glint[11].y = 175; glint[11].phase = 1.948; glint[11].speed = 0.0809;
glint[12].x = 796; glint[12].y = 1025; glint[12].phase = 2.969; glint[12].speed = 0.0488;
glint[13].x = 1089; glint[13].y = 86; glint[13].phase = 5.964; glint[13].speed = 0.0579;
glint[14].x = 1695; glint[14].y = 77; glint[14].phase = 3.450; glint[14].speed = 0.0609;
glint[15].x = 1581; glint[15].y = 1224; glint[15].phase = 5.286; glint[15].speed = 0.0626;
for (i = 0; glint[i]; i++)
  {
    glint[i].sprite = Sprite();
    glint[i].sprite.SetOpacity(0);
  }

# The log: one image per line, revealed left to right (type_px a frame), each
# line starting 6 frames after the one before it has finished.
if (mode == "boot")
  {
    line[0].file = "boot-0.png"; line[0].y[0] = 420; line[0].y[1] = 630;
    line[1].file = "boot-1.png"; line[1].y[0] = 490; line[1].y[1] = 735;
    line[2].file = "boot-2.png"; line[2].y[0] = 525; line[2].y[1] = 788;
    line[3].file = "boot-3.png"; line[3].y[0] = 560; line[3].y[1] = 840;
    line[4].file = "boot-4.png"; line[4].y[0] = 630; line[4].y[1] = 945;
  }
else if (mode == "shutdown")
  {
    line[0].file = "shutdown-0.png"; line[0].y[0] = 420; line[0].y[1] = 630;
    line[1].file = "shutdown-1.png"; line[1].y[0] = 490; line[1].y[1] = 735;
  }
else if (mode == "reboot")
  {
    line[0].file = "reboot-0.png"; line[0].y[0] = 420; line[0].y[1] = 630;
    line[1].file = "reboot-1.png"; line[1].y[0] = 490; line[1].y[1] = 735;
  }
for (i = 0; line[i]; i++)
  {
    line[i].sprite = Sprite();
    line[i].shown = 0;
  }

fill_w = 0;
if (mode == "boot")
  {
    bar.sprite = Sprite();
    bar.sprite.SetOpacity(0);
    fill.sprite = Sprite();
  }

fun put (sprite, x, y, z)
  {
    sprite.SetPosition(global.ox + x, global.oy + y, z);
  }

si = -1;
fun layout ()
  {
    n = 0;
    for (i = 1; set[i]; i++)
      if (set[i].w <= Window.GetWidth() && set[i].h <= Window.GetHeight())
        n = i;
    if (n != global.si)
      {
        global.si = n;
        d = set[n].dir;
        sky.sprite.SetImage(Image(d + "sky.png"));
        earth.sprite.SetImage(Image(d + "earth.png"));
        orbit.sprite.SetImage(Image(d + "orbit.png"));
        sat.sprite.SetImage(Image(d + "satellite.png"));
        g = Image(d + "glint.png");
        for (i = 0; glint[i]; i++)
          glint[i].sprite.SetImage(g);
        at = 40;
        for (i = 0; line[i]; i++)
          {
            line[i].image = Image(d + line[i].file);
            line[i].shown = 0;
            line[i].at = at;
            at = at + Math.Int(line[i].image.GetWidth() / set[n].type_px) + 6;
          }
        global.bar_at = at;
        if (bar)
          {
            bar.sprite.SetImage(Image(d + "bar.png"));
            fill.image = Image(d + "fill.png");
            global.fill_w = 0;
          }
      }
    s = set[n];
    global.ox = Window.GetX() + Math.Int((Window.GetWidth() - s.w) / 2);
    global.oy = Window.GetY() + Math.Int((Window.GetHeight() - s.h) / 2);
    put(sky.sprite, 0, 0, 0);
    put(earth.sprite, s.earth_x, s.earth_y, 20);
    put(orbit.sprite, s.orbit_x, s.orbit_y, 30);
    for (i = 0; glint[i]; i++)
      put(glint[i].sprite, Math.Int(glint[i].x * s.k) - s.glint_half, Math.Int(glint[i].y * s.k) - s.glint_half, 5);
    for (i = 0; line[i]; i++)
      put(line[i].sprite, s.log_x, line[i].y[n], 50);
    if (bar)
      {
        put(bar.sprite, s.bar_x, s.bar_y, 50);
        put(fill.sprite, s.fill_x, s.fill_y, 51);
      }
  }

layout();
Plymouth.SetDisplayHotplugFunction(layout);

t = 0;
fun refresh ()
  {
    global.t = global.t + 1;
    s = set[global.si];
    a = 2.4435 + global.t * 0.010472;
    sn = Math.Sin(a);
    if (sn < 0) z = 10; else z = 40;
    put(sat.sprite, Math.Int(s.cx + s.rx * Math.Cos(a) - s.sat_w / 2), Math.Int(s.cy + s.ry * sn - s.sat_h / 2), z);
    twinkle = Math.Clamp(global.t / 50, 0, 1);
    for (i = 0; glint[i]; i++)
      glint[i].sprite.SetOpacity(twinkle * (0.5 + 0.5 * Math.Sin(global.t * glint[i].speed + glint[i].phase)));
    for (i = 0; line[i]; i++)
      {
        w = Math.Clamp((global.t - line[i].at) * s.type_px, 0, line[i].image.GetWidth());
        if (w > 0 && w != line[i].shown)
          {
            line[i].shown = w;
            line[i].sprite.SetImage(line[i].image.Crop(0, 0, w, line[i].image.GetHeight()));
          }
      }
    if (bar && global.t <= global.bar_at + 15)
      {
        b = Math.Clamp((global.t - global.bar_at) / 15, 0, 1);
        bar.sprite.SetOpacity(b);
        fill.sprite.SetOpacity(b);
      }
  }
Plymouth.SetRefreshFunction(refresh);

fun progress (duration, p)
  {
    if (bar)
      {
        s = set[global.si];
        w = Math.Int(s.inner * Math.Clamp(p, 0, 1));
        if (w < 1) w = 1;
        if (w != global.fill_w)
          {
            global.fill_w = w;
            fill.sprite.SetImage(fill.image.Scale(w, s.fill_h));
          }
      }
  }
Plymouth.SetBootProgressFunction(progress);

fun quit ()
  {
    if (bar)
      fill.sprite.SetImage(fill.image.Scale(set[global.si].inner, set[global.si].fill_h));
  }
Plymouth.SetQuitFunction(quit);
